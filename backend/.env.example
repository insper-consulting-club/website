# Modelo de variáveis de ambiente do backend.
# Em produção, cadastre no painel da hospedagem. No ambiente local o arquivo
# backend/.env é opcional: o docker-compose.yml já define o necessário, e o
# .env serve só para variáveis extras (por exemplo, as de um Cloudinary de
# testes). Nunca coloque valores reais neste arquivo.

# Obrigatória em produção (localmente, o docker-compose.yml define uma chave
# de desenvolvimento). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# True só em desenvolvimento local (o docker-compose já define).
DEBUG=False

# Domínios separados por vírgula, sem https://. Ex.: api.iccinsper.com.br
ALLOWED_HOSTS=

# Endereço do site (frontend), com https://, separados por vírgula.
CORS_ALLOWED_ORIGINS=

# Endereço do próprio backend, com https://. Necessário para o login do /admin.
CSRF_TRUSTED_ORIGINS=

# True quando a hospedagem coloca um proxy com HTTPS na frente do Django
# (Render, Railway, Heroku...). Sem isso, o site entra em loop de redirecionamento.
BEHIND_PROXY=False

# URL de conexão do Postgres de produção (Neon, Supabase...).
# Ex.: postgresql://usuario:senha@host/banco?sslmode=require
# Sem ela, o Django usa o banco local do docker-compose.
DATABASE_URL=

# Cloudinary (fotos de membros, projetos etc.). Sem isso, as imagens ficam no
# disco do servidor e se perdem a cada deploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcional. Endereço do deploy hook do frontend no Render (Settings > Deploy Hook).
# Com ele, salvar a marca, a descrição ou as imagens de compartilhamento em
# Configuração do site reconstrói o frontend sozinho. É um segredo: só no painel.
# RENDER_FRONTEND_DEPLOY_HOOK=

# Opcional. Segundos que o navegador reaproveita as respostas de leitura da API.
# Uma edição no admin leva até esse tempo para aparecer no site. 0 desliga.
# API_CACHE_SECONDS=60
