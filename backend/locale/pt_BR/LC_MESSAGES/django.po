msgstr "Informe um endereço de e-mail válido."

msgid "email address"
msgstr "endereço de e-mail"

#. Django (página de falha do CSRF): 'browser' -> 'navegador'
msgid ""
"If you have configured your browser to disable “Referer” headers, please re-"
"enable them, at least for this site, or for HTTPS connections, or for “same-"
"origin” requests."
msgstr ""
"Se você configurou seu navegador para desabilitar os cabeçalhos “Referer”, "
"reabilite-os, ao menos para este site, para conexões HTTPS ou para "
"requisições “same-origin”."

msgid ""
"If you have configured your browser to disable cookies, please re-enable "
"them, at least for this site, or for “same-origin” requests."
msgstr ""
"Se você configurou seu navegador para desabilitar cookies, reabilite-os, ao "
"menos para este site ou para requisições “same-origin”."

